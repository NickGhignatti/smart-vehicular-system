# Copy this file to .env and fill in the values for your machine.
# .env is git-ignored; .env.example is the committed template.

# --- CARLA server (remote simulator) ---
CARLA_HOST=localhost
CARLA_PORT=2000
# Seconds to wait for RPC calls; load_world over the network can take a while.
CARLA_TIMEOUT=20
# Traffic Manager port. Pick a non-default one if the server is shared with other groups.
CARLA_TM_PORT=8000
# Map to load at startup. Leave empty to keep the map already loaded on the server
# (recommended on a shared server). Town04/Town06 have long straight highway lanes.
CARLA_TOWN=

# --- Simulation ---
# Fixed simulation step in synchronous mode (0.05 s = 20 Hz).
FIXED_DELTA_SECONDS=0.05
# Seed for spawn choices, so runs are reproducible.
SEED=42

# --- Output ---
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
